APP_NAME=mars-api
DEBUG=false

# Use raw values here; the application safely constructs the connection URL.
# Copy this file to .env and configure an existing PostgreSQL database and account.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mars
POSTGRES_PASSWORD=mars_dev_password
POSTGRES_DATABASE=mars
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# 对象存储模式：mock 使用本机磁盘，无需 OSS 资源，供前端联调；s3 使用真实 S3 兼容 OSS。
# Mock 上传地址由 FastAPI 提供，文件保存在 OBJECT_STORAGE_MOCK_DIRECTORY；该目录不会提交到 Git。
# 部署环境必须显式设置 OBJECT_STORAGE_MODE=s3，避免将 Mock 模式用于生产。
OBJECT_STORAGE_MODE=mock
OBJECT_STORAGE_MOCK_DIRECTORY=.local-media
# Mock 上传/读取链接的签名密钥，仅用于本地联调；多人共享环境请更换随机值。
OBJECT_STORAGE_MOCK_SECRET=replace-with-a-random-local-development-secret
# 可选：手动指定手机/浏览器可访问的 API 地址；留空时取当前请求 Host。
OBJECT_STORAGE_MOCK_PUBLIC_BASE_URL=
# Mock 模式下访问业务 API 和直传文件的 Web 开发源站，多个源站用逗号分隔。
OBJECT_STORAGE_MOCK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost,ionic://localhost

# 以下配置仅在 OBJECT_STORAGE_MODE=s3 时使用。需提供兼容 S3 SigV4 的 endpoint、地域、Bucket 和凭据。
# 目标存储还需支持 PUT 条件头 If-None-Match: *，防止同一临时上传 URL 覆盖对象。
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=https://s3.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mars-media
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# 上传/读取授权有效期（秒）；音频/图片/视频最大大小（字节）。
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=600
OBJECT_STORAGE_READ_TTL_SECONDS=600
OBJECT_STORAGE_MAX_AUDIO_BYTES=104857600
OBJECT_STORAGE_MAX_IMAGE_BYTES=20971520
OBJECT_STORAGE_MAX_VIDEO_BYTES=524288000
OBJECT_STORAGE_MAX_TEXT_BYTES=5242880

# AI 模型 API 配置示例。各组默认关闭，目前抽取服务读取 AI_TEXT_ 配置。
# 地址和模型名均为占位值。实际凭据填入 .env 或由部署环境注入。
# PROVIDER 指定适配器，BASE_URL 为该适配器使用的服务基础地址。

# 文本大模型：第二阶段的记忆元素抽取，以及后续实体、冲突、访谈与成书。
AI_TEXT_ENABLED=false
AI_TEXT_PROVIDER=example-provider
AI_TEXT_BASE_URL=https://text-model.example.invalid/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=example-text-model
# 本地联调用 AI_TEXT_PROVIDER=mock。真实兼容接口用 openai-compatible。
# Mock 场景可选 success、empty、retry_once、fallback。切换仅影响新任务。
AI_TEXT_MOCK_SCENARIO=success
AI_TEXT_SYNC_WAIT_SECONDS=5
AI_TEXT_TIMEOUT_SECONDS=30
AI_TEXT_MAX_INPUT_CHARS=20000
AI_TEXT_MAX_ATTEMPTS=3
# 与 App 确认切换后启用，新建会话进入版本化流程并默认 private。
# 测试时可在会话创建请求中显式传 visibility 启用新流程。
MEMORY_PIPELINE_ENABLED=false

# 语音识别（ASR）：版本化流程可使用 mock 或 openai-compatible。
AI_ASR_ENABLED=false
AI_ASR_PROVIDER=example-provider
AI_ASR_BASE_URL=https://asr-model.example.invalid/v1
AI_ASR_API_KEY=
AI_ASR_MODEL=example-asr-model
# 只给支持 verbose_json 和分段时间戳的 ASR 模型开启。
AI_ASR_TIMESTAMPS_ENABLED=false
AI_ASR_MAX_AUDIO_BYTES=26214400

# OCR：旧信件、照片或票据中的文字转录。
AI_OCR_ENABLED=false
AI_OCR_PROVIDER=example-provider
AI_OCR_BASE_URL=https://ocr-model.example.invalid/v1
AI_OCR_API_KEY=
AI_OCR_MODEL=example-ocr-model

# 多模态视觉：照片内容描述与供用户核实的线索。
AI_VISION_ENABLED=false
AI_VISION_PROVIDER=example-provider
AI_VISION_BASE_URL=https://vision-model.example.invalid/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=example-vision-model

# 向量模型：可选的素材语义检索。
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_PROVIDER=example-provider
AI_EMBEDDING_BASE_URL=https://embedding-model.example.invalid/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=example-embedding-model

# 语音合成（TTS）：可选的有声回忆录。
AI_TTS_ENABLED=false
AI_TTS_PROVIDER=example-provider
AI_TTS_BASE_URL=https://tts-model.example.invalid/v1
AI_TTS_API_KEY=
AI_TTS_MODEL=example-tts-model

# 企业权益。线上开放前需接入真实手机号验证。
BENEFIT_ENABLED=false
# 产品体验生成默认关闭。联调时设为 mock，并启动产品体验 Worker。
PRODUCT_EXPERIENCE_PROVIDER=disabled
# 填写版本号与 URL-safe Base64 的 32 字节随机密钥，例如版本 1 使用 1:<密钥>。
# 多个版本逗号分隔，最大版本用于新数据。已有记录仍需对应历史版本密钥。
BENEFIT_CRYPTO_KEYS=
# JSON 数组，填写受控初始化的平台管理员账号 ID。
BENEFIT_BOOTSTRAP_ADMIN_USER_IDS=[]

