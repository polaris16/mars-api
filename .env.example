APP_NAME=mars-api
DEBUG=false

# Use raw values here; the application safely constructs the connection URL.
# Copy this file to .env and configure an existing PostgreSQL database and account.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mars
POSTGRES_PASSWORD=mars_dev_password
POSTGRES_DATABASE=mars
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# 对象存储模式：mock 使用本机磁盘，无需 OSS 资源，供前端联调；s3 使用真实 S3 兼容 OSS。
# Mock 上传地址由 FastAPI 提供，文件保存在 OBJECT_STORAGE_MOCK_DIRECTORY；该目录不会提交到 Git。
# 部署环境必须显式设置 OBJECT_STORAGE_MODE=s3，避免将 Mock 模式用于生产。
OBJECT_STORAGE_MODE=mock
OBJECT_STORAGE_MOCK_DIRECTORY=.local-media
# Mock 上传/读取链接的签名密钥，仅用于本地联调；多人共享环境请更换随机值。
OBJECT_STORAGE_MOCK_SECRET=replace-with-a-random-local-development-secret
# 可选：手动指定手机/浏览器可访问的 API 地址；留空时取当前请求 Host。
OBJECT_STORAGE_MOCK_PUBLIC_BASE_URL=
# Web 前端本地开发源站；Native App 不受浏览器 CORS 限制。
OBJECT_STORAGE_MOCK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost,ionic://localhost

# 以下配置仅在 OBJECT_STORAGE_MODE=s3 时使用。需提供兼容 S3 SigV4 的 endpoint、地域、Bucket 和凭据。
# 目标存储还需支持 PUT 条件头 If-None-Match: *，防止同一临时上传 URL 覆盖对象。
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=https://s3.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mars-media
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# 上传/读取授权有效期（秒）；音频/图片/视频最大大小（字节）。
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=600
OBJECT_STORAGE_READ_TTL_SECONDS=600
OBJECT_STORAGE_MAX_AUDIO_BYTES=104857600
OBJECT_STORAGE_MAX_IMAGE_BYTES=20971520
OBJECT_STORAGE_MAX_VIDEO_BYTES=524288000
OBJECT_STORAGE_MAX_TEXT_BYTES=5242880

